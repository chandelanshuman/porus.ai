# Copy to .env.local and fill in with real values. .env.local is gitignored.
# Vite exposes only variables prefixed with VITE_ to the browser.

# Auth provider client IDs (set the real values from Google / GitHub OAuth apps)
VITE_AUTH_GOOGLE_CLIENT_ID=
VITE_AUTH_GITHUB_CLIENT_ID=

# Backend API base for the auth handoff (leave blank for local stub)
VITE_API_BASE=

# Public site URL (used in canonical links and OAuth redirects)
VITE_SITE_URL=https://porus.ai
